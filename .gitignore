# Ignore all data by default
data/raw/
data/interim/
data/processed/

# Allow DVC metadata
!data/**/*.dvc
!data/**/.gitkeep

# Models
models/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python cache
__pycache__/
*.pyc

# Environment files
.env
venv/

notebooks/03_training/runs/
reports/

# Keep model weights out of Git
models/**/*.pt

# Allow DVC pointer files for model folders
!models/
!models/*.dvc
!models/.gitignore